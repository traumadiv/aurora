<!--
  Frutiger Aero controls: glossy pills, frosted inputs, glass scrollbars, orb checkboxes.
  Every color is a DynamicResource from SkinBuilder.Aero, so the accent recolors all of it.
  Drawn from scratch, no third-party art.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Buttons: a glass pill with a sheen on the top half and a glow on hover ===== -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="MinHeight" Value="23" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="glow" CornerRadius="12" Margin="-2" Background="{DynamicResource GlassGlow}" Opacity="0" />
                        <Border x:Name="b" CornerRadius="11" BorderThickness="1" BorderBrush="{DynamicResource GlassStroke}"
                                Background="{DynamicResource GlassFill}">
                            <Grid>
                                <!-- inner white line: makes it read as glass, not plastic -->
                                <Border CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource GlassInner}" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDefaulted" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource GlassStrokeHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource GlassStrokeHover}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" /></Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard><DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35" /></Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource GlassStrokeHover}" />
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource GlassFillHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource GlassFillPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="b" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="b" CornerRadius="{DynamicResource ToolRadius}" BorderThickness="1" BorderBrush="Transparent"
                            Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource ToolHover}" />
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource ToolHoverBorder}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource ToolPressed}" />
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource GlassStroke}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Inputs: frosted, rounded, accent ring on focus ===== -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource InputBack}" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputStroke}" />
        <Setter Property="Padding" Value="3,2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="ring" CornerRadius="6" Margin="-2" BorderThickness="2" BorderBrush="{DynamicResource GlassGlow}" Opacity="0" />
                        <Border x:Name="b" CornerRadius="5" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                                Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource GlassStrokeHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource InputFocus}" />
                            <Setter TargetName="ring" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource InputBackRO}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource InputBack}" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <Border x:Name="ring" CornerRadius="6" Margin="-2" BorderThickness="2" BorderBrush="{DynamicResource GlassGlow}" Opacity="0" />
                        <Border x:Name="b" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource InputStroke}"
                                Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="3,2" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource InputFocus}" />
                            <Setter TargetName="ring" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RichTextBox (chat history and input) keeps its own background, only the frame is restyled -->
    <Style TargetType="RichTextBox">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputStroke}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RichTextBox">
                    <Border x:Name="b" CornerRadius="6" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                            Background="{TemplateBinding Background}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource InputFocus}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Check boxes and radios: little glass orbs ===== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel Background="Transparent">
                        <Grid Width="15" Height="15" VerticalAlignment="Center" DockPanel.Dock="Left">
                            <Border x:Name="box" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource GlassStroke}" Background="{DynamicResource GlassFill}" />
                            <Border CornerRadius="3" Margin="1" Height="6" VerticalAlignment="Top" Background="{DynamicResource GlassInner}" />
                            <Path x:Name="mark" Data="M3.5,7.5 L6.5,10.5 L11.5,4" Stroke="{DynamicResource CheckMark}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="Background" Value="{DynamicResource GlassFillHover}" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource GlassStrokeHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plain radios only. Settings' skin cards and color swatches set their own Style. -->
    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <DockPanel Background="Transparent">
                        <Grid Width="15" Height="15" VerticalAlignment="Center" DockPanel.Dock="Left">
                            <Ellipse x:Name="box" Stroke="{DynamicResource GlassStroke}" Fill="{DynamicResource GlassFill}" />
                            <Ellipse x:Name="dot" Margin="4" Fill="{DynamicResource Selected}" Stroke="{DynamicResource SelectedBorder}" Visibility="Collapsed" />
                            <Ellipse Margin="2,1.5,2,7" Fill="#A0FFFFFF" />
                        </Grid>
                        <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="Stroke" Value="{DynamicResource GlassStrokeHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Tabs: glass tabs on a frosted panel ===== -->
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="b" CornerRadius="8,8,0,0" BorderThickness="1,1,1,0" BorderBrush="{DynamicResource TabStroke}" Margin="0,3,2,0"
                            Padding="11,3,11,3" Background="{DynamicResource TabFill}">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource GlassFillHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="Margin" Value="-1,0,1,-1" />
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource TabSelected}" />
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource GlassStrokeHover}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Panel.ZIndex" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <TabPanel DockPanel.Dock="Top" IsItemsHost="True" Margin="5,0,5,0" Panel.ZIndex="1" />
                        <Border BorderBrush="{DynamicResource GlassStrokeHover}" BorderThickness="1" CornerRadius="0,6,6,6" Background="{DynamicResource PanelBack}">
                            <Grid>
                                <Border CornerRadius="0,5,5,5" BorderThickness="1" BorderBrush="{DynamicResource GlassInner}" />
                                <ContentPresenter ContentSource="SelectedContent" Margin="1" />
                            </Grid>
                        </Border>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Scrollbars: thin frosted track, glassy capsule thumb, no arrows ===== -->
    <Style x:Key="AeroThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="t" CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource GlassStroke}" Background="{DynamicResource ThumbFill}">
                        <Border CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource GlassInner}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Background" Value="{DynamicResource ThumbHover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="t" Property="Background" Value="{DynamicResource ThumbHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AeroPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border CornerRadius="5" Background="{DynamicResource TrackFill}" Margin="1">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource AeroPage}" Command="ScrollBar.PageUpCommand" /></Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource AeroPage}" Command="ScrollBar.PageDownCommand" /></Track.IncreaseRepeatButton>
                            <Track.Thumb><Thumb Style="{StaticResource AeroThumb}" MinHeight="24" /></Track.Thumb>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border CornerRadius="5" Background="{DynamicResource TrackFill}" Margin="1">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource AeroPage}" Command="ScrollBar.PageLeftCommand" /></Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource AeroPage}" Command="ScrollBar.PageRightCommand" /></Track.IncreaseRepeatButton>
                                    <Track.Thumb><Thumb Style="{StaticResource AeroThumb}" MinWidth="24" /></Track.Thumb>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Menus and tooltips: frosted glass sheets with a soft shadow ===== -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="{DynamicResource UiFontSize}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="0,0,6,6" CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource GlassStrokeHover}"
                            Background="{DynamicResource MenuBack}" Padding="3">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.35" Color="{DynamicResource ShadowColor}" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="b" CornerRadius="5" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Padding="6,3,18,3">
                        <DockPanel>
                            <ContentPresenter x:Name="icon" ContentSource="Icon" Width="16" Margin="0,0,8,0" DockPanel.Dock="Left" VerticalAlignment="Center" />
                            <TextBlock x:Name="check" Text="✓" Width="0" DockPanel.Dock="Left" Foreground="{DynamicResource CheckMark}" FontWeight="Bold" Visibility="Collapsed" />
                            <TextBlock Text="{TemplateBinding InputGestureText}" DockPanel.Dock="Right" Margin="18,0,0,0" Foreground="{DynamicResource SubText}" />
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Selected}" />
                            <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource SelectedBorder}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="check" Property="Visibility" Value="Visible" />
                            <Setter TargetName="check" Property="Width" Value="16" />
                            <Setter TargetName="icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator" x:Key="{x:Static MenuItem.SeparatorStyleKey}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="6,3" Background="{DynamicResource Line}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Margin="0,0,5,5" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource GlassStroke}"
                            Background="{DynamicResource MenuBack}" Padding="8,4">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" Color="{DynamicResource ShadowColor}" />
                        </Border.Effect>
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text colors for controls left to the system theme -->
    <Style TargetType="ListBox">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Frame}" />
    </Style>
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
</ResourceDictionary>
