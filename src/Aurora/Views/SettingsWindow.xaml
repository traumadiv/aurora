<Window x:Class="Aurora.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Aurora.Views"
        Title="Aurora — настройки" Width="660" Height="500" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen" Style="{StaticResource XpWindow}">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Heading}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Field" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="8">
        <!-- Buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <TextBlock x:Name="Status" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource Typing}" />
            <Button Width="80" Height="23" IsDefault="True" Click="Ok_Click">OK</Button>
            <Button Width="80" Height="23" Margin="6,0,0,0" IsCancel="True">Отмена</Button>
            <Button Width="80" Height="23" Margin="6,0,0,0" Click="Apply_Click">Применить</Button>
        </StackPanel>

        <!-- Section tree, ICQ Preferences style -->
        <ListBox x:Name="Nav" DockPanel.Dock="Left" Width="160" Margin="0,0,8,0" SelectionChanged="Nav_SelectionChanged"
                 ItemContainerStyle="{StaticResource GlassItem}" Background="{DynamicResource Sheet}" BorderBrush="{DynamicResource Frame}" Padding="0,3">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="2,3">
                        <Image Source="{Binding Icon, Converter={StaticResource Icon}}" Width="16" Height="16" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Background="{DynamicResource Sheet}" CornerRadius="{DynamicResource SheetRadius}" BorderBrush="{DynamicResource Frame}" BorderThickness="1" Padding="14,12">
            <Grid>
                <!-- Profile -->
                <ScrollViewer x:Name="ProfilePage" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Section}" Text="Мой профиль" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Field}" Text="Имя:" />
                                <TextBox x:Name="FirstName" Height="21" MaxLength="64" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Field}" Text="Фамилия:" />
                                <TextBox x:Name="LastName" Height="21" MaxLength="64" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Field}" Text="Имя пользователя:" Margin="0,10,0,2" />
                        <DockPanel>
                            <TextBlock Text="@" VerticalAlignment="Center" Margin="0,0,3,0" Foreground="{DynamicResource Muted}" FontSize="13" />
                            <TextBox x:Name="Username" Height="21" MaxLength="32" />
                        </DockPanel>
                        <TextBlock Text="Латиница, цифры и _, от 5 символов. По нему вас найдут без номера." Foreground="{DynamicResource Muted}"
                                   FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap" />
                        <DockPanel Margin="0,10,0,2">
                            <TextBlock x:Name="BioCount" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" FontSize="10" />
                            <TextBlock Style="{StaticResource Field}" Text="О себе:" />
                        </DockPanel>
                        <TextBox x:Name="Bio" Height="48" TextWrapping="Wrap" AcceptsReturn="False" MaxLength="70"
                                 TextChanged="Bio_TextChanged" />
                        <TextBlock Style="{StaticResource Field}" Text="Телефон:" Margin="0,10,0,2" />
                        <TextBox x:Name="PhoneBox" Height="21" IsReadOnly="True" />
                        <TextBlock x:Name="ProfileError" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Notifications -->
                <StackPanel x:Name="NotifyPage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Section}" Text="Уведомления" />
                    <CheckBox x:Name="PlaySounds" Content="Звук при новом сообщении" />
                    <CheckBox x:Name="NotifyGroups" Content="Уведомлять о сообщениях в группах" />
                    <CheckBox x:Name="Popup" Content="Сразу открывать окно чата при новом сообщении" />
                    <TextBlock Style="{StaticResource Field}" Text="Звук сообщения:" Margin="0,6,0,2" />
                    <TextBlock x:Name="SoundName" FontWeight="Bold" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <Button Width="120" Height="23" Click="TestSound_Click">▶ Проверить</Button>
                        <Button Width="150" Height="23" Margin="6,0,0,0" Click="PickSound_Click">Выбрать свой звук…</Button>
                        <Button x:Name="ResetSoundBtn" Width="100" Height="23" Margin="6,0,0,0" Click="ResetSound_Click">Стандартный</Button>
                    </StackPanel>
                    <TextBlock Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Подойдёт любой короткий .wav или .mp3. Файл копируется в %APPDATA%\Aurora\sounds." />
                    <TextBlock Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Чаты без звука (правый клик → «Без звука») не мигают и не звенят." />
                </StackPanel>

                <!-- Appearance -->
                <ScrollViewer x:Name="LookPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource Section}" Text="Внешний вид" />
                    <TextBlock Style="{StaticResource Field}" Text="Скин (применяется сразу):" Margin="0,0,0,6" />
                    <WrapPanel x:Name="SkinCards" />
                    <TextBlock Style="{StaticResource Field}" Text="Цвет скина:" Margin="0,12,0,6" />
                    <WrapPanel x:Name="Swatches" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBox x:Name="AccentHex" Width="74" Height="22" VerticalContentAlignment="Center" KeyDown="AccentHex_KeyDown"
                                 ToolTip="Свой цвет в формате #RRGGBB, Enter применяет" />
                        <Button Width="110" Height="23" Margin="6,0,0,0" Click="AccentCustom_Click">Свой цвет…</Button>
                        <Button x:Name="AccentDefault" Width="110" Height="23" Margin="6,0,0,0" Click="AccentDefault_Click">По умолчанию</Button>
                    </StackPanel>
                    <TextBlock Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="Цвет запоминается для каждого скина отдельно и меняет стекло, выделение, кнопки и фон." />
                </StackPanel>
                </ScrollViewer>

                <!-- Contact list -->
                <StackPanel x:Name="ListPage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Section}" Text="Контакт-лист" />
                    <CheckBox x:Name="HideOffline" Content="Скрывать контакты не в сети" />
                    <CheckBox x:Name="OnTop" Content="Окно поверх всех окон" />
                    <CheckBox x:Name="KeepDeleted" Content="Показывать удалённые сообщения и прошлые версии правок" />
                    <TextBlock Foreground="{DynamicResource Muted}" FontSize="10" Margin="20,-4,0,8" TextWrapping="Wrap"
                               Text="Aurora хранит копию полученных сообщений у вас на компьютере (%APPDATA%\Aurora\archive). Если собеседник удалит или изменит сообщение, вы всё равно увидите, что там было. Работает для сообщений, полученных, пока Aurora была запущена." />
                    <TextBlock Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap">
                        Горячие клавиши: начните печатать в списке, чтобы найти контакт; Ctrl+Tab переключает
                        «Контакты» и «Чаты»; Ctrl+P открывает настройки; Alt+M открывает меню.
                    </TextBlock>
                </StackPanel>

                <!-- Smileys -->
                <DockPanel x:Name="SmileysPage" Visibility="Collapsed">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Section}" Text="Смайлы" />
                    <CheckBox DockPanel.Dock="Top" x:Name="UseSmileys" Content="Показывать смайлы картинками" />
                    <TextBlock DockPanel.Dock="Top" x:Name="PackInfo" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Width="160" Height="23" Click="SmileyFolder_Click">Папка смайлов…</Button>
                        <Button Width="120" Height="23" Margin="6,0,0,0" Click="SmileyReload_Click">Перезагрузить</Button>
                    </StackPanel>
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <WrapPanel x:Name="SmileyPreview" />
                        </ScrollViewer>
                    </Border>
                </DockPanel>

                <!-- Proxy -->
                <DockPanel x:Name="ProxyPage" Visibility="Collapsed">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Section}" Text="Прокси: MTProxy и SOCKS5" />
                    <v:ProxyPanel />
                </DockPanel>

                <!-- Account -->
                <StackPanel x:Name="AccountPage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Section}" Text="Аккаунт" />
                    <TextBlock x:Name="AccountInfo" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <Button Width="170" Height="23" HorizontalAlignment="Left" Click="LogOut_Click">Выйти из аккаунта…</Button>
                    <TextBlock Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,14,0,0" TextWrapping="Wrap"
                               Text="Aurora — открытый клиент Telegram. Данные хранятся только на этом компьютере, в папке %APPDATA%\Aurora." />
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</Window>
