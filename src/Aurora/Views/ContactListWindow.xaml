<Window x:Class="Aurora.Views.ContactListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:Aurora.Services"
        Title="Aurora" Width="240" Height="580" MinWidth="190" MinHeight="280"
        Style="{StaticResource XpWindow}">
    <Window.Resources>
        <!-- Shared list item chrome: XP selection blue, soft green hover -->
        <Style x:Key="Row" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="b" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Margin="2,0"
                                CornerRadius="{DynamicResource RowRadius}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource HoverBorder}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Selected}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource SelectedBorder}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Contacts tab: one line per person, ICQ classic -->
        <DataTemplate x:Key="ContactRow">
            <DockPanel Height="19" Margin="14,0,3,0" ToolTipService.InitialShowDelay="600">
                <DockPanel.ToolTip>
                    <StackPanel MaxWidth="280">
                        <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Muted}" />
                    </StackPanel>
                </DockPanel.ToolTip>
                <Grid Width="16" Height="16" Margin="0,0,5,0" DockPanel.Dock="Left">
                    <Image x:Name="st" Source="{Binding Icon, Converter={StaticResource Icon}}" />
                    <Border x:Name="env" Background="Transparent" Visibility="Collapsed">
                        <Image Source="{Binding Source=msg, Converter={StaticResource Icon}}" />
                    </Border>
                </Grid>
                <TextBlock x:Name="name" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <DataTemplate.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasUnread}" Value="True" />
                        <Condition Binding="{Binding Muted}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="env" Property="Visibility" Value="Visible" />
                    <Setter TargetName="name" Property="FontWeight" Value="Bold" />
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard x:Name="blinkC">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="env" Storyboard.TargetProperty="Opacity" Duration="0:0:1">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="0" />
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="st" Storyboard.TargetProperty="Opacity" Duration="0:0:1">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="1" />
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="blinkC" />
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Presence}" Value="Offline">
                    <Setter TargetName="name" Property="Foreground" Value="{DynamicResource Muted}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Chats tab: two lines with preview and time -->
        <DataTemplate x:Key="ChatRow">
            <Grid Height="36" Margin="4,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid Grid.RowSpan="2" Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Image x:Name="st" Source="{Binding Icon, Converter={StaticResource Icon}}" />
                    <Border x:Name="env" Background="Transparent" Visibility="Collapsed">
                        <Image Source="{Binding Source=msg, Converter={StaticResource Icon}}" />
                    </Border>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,1">
                    <Path x:Name="pin" Data="M2,0 L6,0 L5.4,3 L7,4.6 L4.4,4.6 L4,8 L3.6,4.6 L1,4.6 L2.6,3 Z" Fill="{DynamicResource Muted}"
                          Margin="0,0,4,0" VerticalAlignment="Center" Visibility="Collapsed" />
                    <TextBlock x:Name="name" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <Path x:Name="mute" Data="M0,2.5 L2,2.5 L4.5,0 L4.5,8 L2,5.5 L0,5.5 Z M6,2 L9,6 M9,2 L6,6" Stroke="{DynamicResource Muted}"
                          Fill="{DynamicResource Muted}" StrokeThickness="0.8" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>
                <TextBlock x:Name="time" Grid.Column="2" Text="{Binding TimeText}" Foreground="{DynamicResource Muted}" FontSize="10"
                           VerticalAlignment="Bottom" Margin="4,0,0,1" />
                <TextBlock x:Name="preview" Grid.Row="1" Grid.Column="1" s:Smileys.Text="{Binding Preview}" Foreground="{DynamicResource Muted}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Top" Margin="0,1,0,0" />
                <Border x:Name="badge" Grid.Row="1" Grid.Column="2" Background="{DynamicResource Badge}" CornerRadius="7" Padding="5,0" Height="14"
                        MinWidth="14" Margin="4,1,0,0" VerticalAlignment="Top" HorizontalAlignment="Right"
                        Visibility="{Binding HasUnread, Converter={StaticResource Vis}}">
                    <TextBlock Text="{Binding UnreadBadge}" FontSize="9" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasUnread}" Value="True" />
                        <Condition Binding="{Binding Muted}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="env" Property="Visibility" Value="Visible" />
                    <Setter TargetName="name" Property="FontWeight" Value="Bold" />
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard x:Name="blinkH">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="env" Storyboard.TargetProperty="Opacity" Duration="0:0:1">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="0" />
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="st" Storyboard.TargetProperty="Opacity" Duration="0:0:1">
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="1" />
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <RemoveStoryboard BeginStoryboardName="blinkH" />
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Muted}" Value="True">
                    <Setter TargetName="mute" Property="Visibility" Value="Visible" />
                    <Setter TargetName="badge" Property="Background" Value="#A9B2BB" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Pinned}" Value="True">
                    <Setter TargetName="pin" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsTyping}" Value="True">
                    <Setter TargetName="preview" Property="Foreground" Value="{DynamicResource Typing}" />
                    <Setter TargetName="preview" Property="FontStyle" Value="Italic" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="preview" Property="Foreground" Value="#DCE6F7" />
                    <Setter TargetName="time" Property="Foreground" Value="#DCE6F7" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Collapsible "В сети / Не в сети" headers -->
        <GroupStyle x:Key="Groups">
            <GroupStyle.ContainerStyle>
                <Style TargetType="GroupItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="GroupItem">
                                <Expander IsExpanded="True" Loaded="Group_Loaded" Expanded="Group_Toggled" Collapsed="Group_Toggled">
                                    <Expander.Template>
                                        <ControlTemplate TargetType="Expander">
                                            <DockPanel>
                                                <ToggleButton DockPanel.Dock="Top" Focusable="False"
                                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border Background="Transparent" Padding="4,3,4,2">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Path x:Name="arrow" Data="M0,0 L8,0 L4,5 Z" Fill="{DynamicResource Arrow}" Margin="1,0,6,0"
                                                                          VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
                                                                    <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource AncestorType=Expander}}" />
                                                                </StackPanel>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="False">
                                                                    <Setter TargetName="arrow" Property="RenderTransform">
                                                                        <Setter.Value><RotateTransform Angle="-90" /></Setter.Value>
                                                                    </Setter>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>
                                                <ContentPresenter x:Name="body" Visibility="Collapsed" />
                                            </DockPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsExpanded" Value="True">
                                                    <Setter TargetName="body" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Expander.Template>
                                    <Expander.Header>
                                        <TextBlock FontWeight="Bold" Foreground="{DynamicResource Accent}">
                                            <Run Text="{Binding Name, Mode=OneWay}" />
                                            <Run Text="{Binding ItemCount, Mode=OneWay, StringFormat=({0})}" Foreground="{DynamicResource AccentSoft}" FontWeight="Normal" />
                                        </TextBlock>
                                    </Expander.Header>
                                    <ItemsPresenter />
                                </Expander>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </GroupStyle.ContainerStyle>
        </GroupStyle>

        <!-- Filter chips in the Chats tab -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="8" Padding="7,1,7,2" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource ToolHover}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource ToolHoverBorder}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Badge}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource BadgeBorder}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header: who am I. Click opens the profile. -->
        <Border DockPanel.Dock="Top" Padding="6,5" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Cursor="Hand"
                MouseLeftButtonUp="Me_Click" ToolTip="Мой профиль">
            <Border.Background><DynamicResource ResourceKey="Header" /></Border.Background>
            <DockPanel>
                <Image x:Name="MeIcon" Width="22" Height="22" Margin="0,0,6,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="MeName" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MeSub" Foreground="{DynamicResource SubText}" FontSize="10" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Bottom bar: Menu + status -->
        <Border DockPanel.Dock="Bottom" Padding="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <DockPanel>
                <Button x:Name="MenuBtn" DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Click="Menu_Click" ToolTip="Меню (Alt+M)">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding Source=online, Converter={StaticResource Icon}}" Width="16" Height="16" Margin="0,0,4,0" />
                        <TextBlock Text="Меню" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="StatusBtn" DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Click="Status_Click" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="StatusIcon" Width="16" Height="16" Margin="0,0,4,0" />
                        <TextBlock x:Name="StatusText" Text="В сети" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border />
            </DockPanel>
        </Border>

        <!-- Quick search -->
        <Grid DockPanel.Dock="Bottom" Margin="3,3,3,0">
            <TextBox x:Name="Search" Height="21" TextChanged="Search_TextChanged" PreviewKeyDown="Search_KeyDown" />
            <TextBlock Text="Поиск (Ctrl+F)" Foreground="{DynamicResource Muted}" Margin="6,0,0,0" VerticalAlignment="Center"
                       IsHitTestVisible="False" x:Name="SearchHint" />
        </Grid>

        <TabControl x:Name="Tabs" Margin="2,4,2,0" Padding="0" SelectionChanged="Tabs_SelectionChanged">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding Source=online, Converter={StaticResource Icon}}" Width="14" Height="14" Margin="0,0,4,0" />
                        <TextBlock Text="Контакты" />
                    </StackPanel>
                </TabItem.Header>
                <ListBox x:Name="ContactsList" BorderThickness="0" Background="{DynamicResource ListBack}"
                         ItemTemplate="{StaticResource ContactRow}" ItemContainerStyle="{StaticResource Row}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                         MouseDoubleClick="List_DoubleClick" PreviewKeyDown="List_KeyDown" TextInput="List_TextInput"
                         PreviewMouseRightButtonDown="List_RightDown" ContextMenuOpening="List_ContextMenu">
                    <ListBox.ContextMenu><ContextMenu /></ListBox.ContextMenu>
                </ListBox>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding Source=msg, Converter={StaticResource Icon}}" Width="14" Height="14" Margin="0,0,4,0" />
                        <TextBlock Text="Чаты" />
                        <Border x:Name="ChatsBadge" Background="{DynamicResource Badge}" CornerRadius="6" Padding="4,0" Margin="4,0,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="ChatsBadgeText" FontSize="9" FontWeight="Bold" Foreground="White" />
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <DockPanel Background="{DynamicResource ListBack}">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,4,4,3">
                        <RadioButton Style="{StaticResource Chip}" Content="Все" Tag="all" IsChecked="True" Checked="Filter_Checked" />
                        <RadioButton Style="{StaticResource Chip}" Content="Личные" Tag="private" Checked="Filter_Checked" />
                        <RadioButton Style="{StaticResource Chip}" Content="Группы" Tag="groups" Checked="Filter_Checked" />
                        <RadioButton Style="{StaticResource Chip}" Content="Каналы" Tag="channels" Checked="Filter_Checked" />
                    </StackPanel>
                    <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Line}" />
                    <ListBox x:Name="ChatsList" BorderThickness="0" Background="{DynamicResource ListBack}"
                             ItemTemplate="{StaticResource ChatRow}" ItemContainerStyle="{StaticResource Row}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             MouseDoubleClick="List_DoubleClick" PreviewKeyDown="List_KeyDown" TextInput="List_TextInput"
                             PreviewMouseRightButtonDown="List_RightDown" ContextMenuOpening="List_ContextMenu">
                        <ListBox.ContextMenu><ContextMenu /></ListBox.ContextMenu>
                    </ListBox>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
