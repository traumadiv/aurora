<Window x:Class="Aurora.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" Height="460" MinWidth="320" MinHeight="300"
        Style="{StaticResource XpWindow}" AllowDrop="True" PreviewDragOver="Window_DragOver" PreviewDrop="Window_Drop">
    <DockPanel>
        <!-- Who we talk to -->
        <Border DockPanel.Dock="Top" Padding="8,6" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <Border.Background><DynamicResource ResourceKey="Header" /></Border.Background>
            <DockPanel>
                <Image DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,8,0"
                       Source="{Binding Icon, Converter={StaticResource Icon}}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Click="Info_Click" ToolTip="Информация"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="14" Height="14" CornerRadius="7" Background="#3B78D8" Margin="0,0,4,0">
                            <TextBlock Text="i" Foreground="White" FontWeight="Bold" FontFamily="Georgia"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Инфо" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis" />
                    <Grid>
                        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource SubText}" x:Name="StatusLine" />
                        <TextBlock Text="{Binding Typing}" Foreground="{DynamicResource Typing}" FontStyle="Italic" Background="{DynamicResource TypingBg}"
                                   Visibility="{Binding IsTyping, Converter={StaticResource Vis}}" />
                    </Grid>
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel Margin="6">
            <!-- Buttons -->
            <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Left" Width="75" Height="23" Click="Close_Click">Закрыть</Button>
                <TextBlock DockPanel.Dock="Left" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="10"
                           Text="Enter — отправить, ↑ — изменить последнее" />
                <Button x:Name="SendBtn" DockPanel.Dock="Right" Width="96" Height="23" FontWeight="Bold" Click="Send_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SendText" Text="Отправить" VerticalAlignment="Center" />
                        <Path Data="M0,0 L7,4 L0,8 L1.6,4 Z" Fill="{DynamicResource Typing}" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </DockPanel>

            <!-- Input -->
            <TextBox x:Name="Input" DockPanel.Dock="Bottom" Height="66" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="False" FontSize="12"
                     PreviewKeyDown="Input_KeyDown" TextChanged="Input_TextChanged" />

            <!-- Edit mode: what is being changed -->
            <Border x:Name="EditBar" DockPanel.Dock="Bottom" Visibility="Collapsed" Background="{DynamicResource TypingBg}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1,1,1,0" Padding="6,3">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Click="CancelEdit_Click" ToolTip="Отменить (Esc)" Padding="5,0">✕</Button>
                    <TextBlock DockPanel.Dock="Left" Text="✎ Редактирование:" FontWeight="Bold" Foreground="{DynamicResource Typing}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="EditPreview" Foreground="{DynamicResource SubText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Toolbar between history and input, like the old message window -->
            <Border DockPanel.Dock="Bottom" Background="{DynamicResource Toolbar}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,1,0" Padding="3,2">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="SmileBtn" Style="{StaticResource BarButton}" ToolTip="Смайлы (Ctrl+E)">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="SmileIcon" Width="16" Height="16" Margin="0,0,5,0" />
                            <TextBlock Text="Смайлы" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <Popup x:Name="SmilePopup" PlacementTarget="{Binding ElementName=SmileBtn}" Placement="Top"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                           IsOpen="{Binding IsChecked, ElementName=SmileBtn, Mode=TwoWay}">
                        <Border Background="{DynamicResource Sheet}" CornerRadius="{DynamicResource SheetRadius}" BorderBrush="{DynamicResource Frame}" BorderThickness="1" Padding="4" Margin="0,0,6,6">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="3" BlurRadius="6" Opacity="0.35" />
                            </Border.Effect>
                            <WrapPanel x:Name="SmileGrid" Width="248" />
                        </Border>
                    </Popup>
                    <Button Style="{StaticResource BarButton}" Click="Photo_Click" ToolTip="Отправить фото. Можно вставить через Ctrl+V или перетащить файл в окно">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource IcoPhoto}" Width="16" Height="16" Margin="0,0,5,0" />
                            <TextBlock Text="Фото" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <ToggleButton x:Name="StickerBtn" Style="{StaticResource BarButton}" ToolTip="Стикеры из ваших наборов Telegram">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{StaticResource IcoSticker}" Width="16" Height="16" Margin="0,0,5,0" />
                            <TextBlock Text="Стикеры" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <Popup x:Name="StickerPopup" PlacementTarget="{Binding ElementName=StickerBtn}" Placement="Top"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Opened="StickerPopup_Opened"
                           IsOpen="{Binding IsChecked, ElementName=StickerBtn, Mode=TwoWay}">
                        <Border Background="{DynamicResource Sheet}" CornerRadius="{DynamicResource SheetRadius}" BorderBrush="{DynamicResource Frame}" BorderThickness="1" Padding="4" Margin="0,0,6,6">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="3" BlurRadius="6" Opacity="0.35" />
                            </Border.Effect>
                            <DockPanel Width="336">
                                <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,4">
                                    <StackPanel x:Name="StickerSets" Orientation="Horizontal" />
                                </ScrollViewer>
                                <TextBlock x:Name="StickerNote" DockPanel.Dock="Top" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="2,0,2,4" />
                                <ScrollViewer Height="270" VerticalScrollBarVisibility="Auto">
                                    <WrapPanel x:Name="StickerGrid" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Border>

            <!-- History -->
            <RichTextBox x:Name="History" IsReadOnly="True" IsDocumentEnabled="True" ContextMenuOpening="History_ContextMenuOpening" VerticalScrollBarVisibility="Auto"
                         IsUndoEnabled="False" Background="{DynamicResource ChatBack}" Padding="2">
                <RichTextBox.ContextMenu><ContextMenu /></RichTextBox.ContextMenu>
                <FlowDocument x:Name="Doc" FontFamily="{DynamicResource ChatFont}" FontSize="12" PagePadding="4" />
            </RichTextBox>
        </DockPanel>
    </DockPanel>
</Window>
